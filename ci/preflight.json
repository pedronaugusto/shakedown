{
  "sources": [
    "src",
    "bench"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**",
    "bench/**"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "shakedown"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-source32"
    ],
    [
      "zig",
      "build",
      "check-bench-consumer"
    ],
    [
      "zig",
      "build",
      "check-aegis-consumer"
    ]
  ],
  "glint": {
    "rules": [{"id": "P001", "level": "gate"}, {"id": "P003", "level": "gate"}, 
      {
        "id": "A001",
        "level": "report"
      },
      {
        "id": "A002",
        "level": "report"
      },
      {
        "id": "A003",
        "level": "report"
      },
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      }
    ]
  }
}
